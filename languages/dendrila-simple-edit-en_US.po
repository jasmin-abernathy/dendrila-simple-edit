msgstr "History"

msgid "Menu principal"
msgstr "Main menu"

msgid ""
"Mettez à jour uniquement les informations de produits qui vous ont été "
"confiées."
msgstr "Update only the product information assigned to you."

msgid "Modifier les produits"
msgstr "Edit products"

msgid "Modifier mon site"
msgstr "Edit my site"

msgid "Modifier un article"
msgstr "Edit an article"

msgid "Modifier un événement"
msgstr "Edit an event"

